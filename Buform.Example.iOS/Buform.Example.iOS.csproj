<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Buform.Example.iOS</RootNamespace>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.fedandburk.buform</ApplicationId>
    <ApplicationTitle>Buform</ApplicationTitle>
    <MtouchLink>SdkOnly</MtouchLink>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Buform.Example\Buform.Example.csproj" />
  </ItemGroup>
</Project>
