<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="@dimen/form_horizontal_padding"
  android:paddingEnd="@dimen/form_horizontal_padding"
  android:paddingTop="@dimen/form_vertical_padding"
  android:paddingBottom="@dimen/form_vertical_padding"
>
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/TextView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/form_horizontal_padding"
    android:layout_marginEnd="@dimen/form_horizontal_padding"
    android:textAppearance="?attr/textAppearanceBodySmall"
    android:textColor="?android:attr/textColorSecondary"
    tools:text="Footer"
  />
</FrameLayout>
