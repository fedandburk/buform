<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/form_horizontal_padding"
    android:paddingEnd="@dimen/form_horizontal_padding"
    android:paddingTop="@dimen/form_vertical_padding"
    android:paddingBottom="@dimen/form_vertical_padding"
    android:focusable="false"
    android:clickable="true">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_item_height_compact"
        android:minHeight="@dimen/form_item_height_compact"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="false"
        tools:text="@strings/button"/>
</FrameLayout>