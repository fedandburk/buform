<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Buform</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Fedandburk.Buform.FluentValidation</PackageId>
    <PackageVersion>0.8.0</PackageVersion>
    <Title>Buform.FluentValidation</Title>
    <Description>FluentValidation support for Buform.</Description>
    <Copyright>FEDANDBURK</Copyright>
    <Authors>Prin53, FEDANDBURK</Authors>
    <Owners>Prin53, FEDANDBURK</Owners>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageTags>xamarin, forms, form, fluentvalidation</PackageTags>
    <PackageIconUrl>https://static.fedandburk.com/logo.svg</PackageIconUrl>
    <PackageProjectUrl>https://github.com/fedandburk/buform</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Moved to .NET 11 and .NET MAUI 11. Renamed the API, with breaking changes. Removed the MvvmCross package.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fedandburk/buform</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Buform\Buform.csproj" Private="false" />
  </ItemGroup>
</Project>
