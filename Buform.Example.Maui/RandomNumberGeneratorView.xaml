<?xml version="1.0" encoding="utf-8"?>

<maui:FormItemView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:maui="clr-namespace:Buform;assembly=Buform.Maui"
  xmlns:buform="clr-namespace:Buform.Example;assembly=Buform.Example"
  x:Class="Buform.Example.Maui.RandomNumberGeneratorView"
  MinimumHeightRequest="{OnPlatform iOS=80, Default=-1}"
  x:TypeArguments="buform:RandomNumberGeneratorItem"
  x:DataType="buform:RandomNumberGeneratorItem"
>
  <maui:FormItemView.Content>
    <Grid Padding="{OnPlatform iOS='16, 8', Default=0}" ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label
        Grid.Column="0"
        Text="{Binding FormattedValue}"
        FontSize="18"
        VerticalTextAlignment="Center"
        HorizontalTextAlignment="Start"
        HorizontalOptions="Fill"
        VerticalOptions="Center"
        LineBreakMode="TailTruncation"
        MaxLines="1"
      />
      <Button
        Grid.Column="1"
        FontSize="18"
        Text="Generate random number"
        Command="{Binding GenerateCommand}"
      />
    </Grid>
  </maui:FormItemView.Content>
</maui:FormItemView>
